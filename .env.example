# --- инференс (OpenAI-совместимый эндпоинт) ---
# Для отладки годится роутер HuggingFace: те же модели, тот же протокол,
# guided decoding по JSON Schema поддерживается. Ключ — токен HF.
DECKFORGE_LLM_BASE_URL=https://router.huggingface.co/v1
DECKFORGE_LLM_API_KEY=hf_ваш_токен
DECKFORGE_VLM_BASE_URL=https://router.huggingface.co/v1
DECKFORGE_VLM_API_KEY=hf_ваш_токен
DECKFORGE_T2I_BASE_URL=https://router.huggingface.co/v1
DECKFORGE_T2I_API_KEY=hf_ваш_токен

# Локальный vLLM или инференс VK — то же самое, другой адрес:
#   DECKFORGE_LLM_BASE_URL=http://localhost:8000/v1

# --- инфраструктура ---
DECKFORGE_REDIS_URL=redis://localhost:6379/0
DECKFORGE_S3_ENDPOINT=http://localhost:9000
DECKFORGE_S3_ACCESS_KEY=minioadmin
DECKFORGE_S3_SECRET_KEY=minioadmin
DECKFORGE_S3_BUCKET=deckforge
DECKFORGE_LANGUAGETOOL_URL=http://localhost:8010

# --- сервисы вёрстки ---
DECKFORGE_SOFFICE_BIN=soffice

# --- трейсинг (опционально) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
