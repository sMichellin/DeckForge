    "FontUsage": {
      "additionalProperties": false,
      "description": "Сколько знаков в шаблоне набрано этой гарнитурой.\n\nТема называет гарнитуру, которой шаблон не пользуется: у всех трёх шаблонов кейса\nв теме Arial, а примеры набраны Play. Аудит, сверяющий шрифт колоды с темой, на этом\nдаёт ложные находки (C3, C10).",
      "properties": {
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "chars": {
          "minimum": 0,
          "title": "Chars",
          "type": "integer"
        },
        "share": {
          "description": "Доля знаков шаблона",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Share",
          "type": "number"
        },
        "in_titles": {
          "default": false,
          "description": "Встречается в ролях заголовка",
          "title": "In Titles",
          "type": "boolean"
        },
        "in_body": {
          "default": false,
          "description": "Встречается в основном тексте",
          "title": "In Body",
          "type": "boolean"
        }
      },
      "required": [
        "family",
        "chars",
        "share"
      ],
      "title": "FontUsage",
      "type": "object"
    },
