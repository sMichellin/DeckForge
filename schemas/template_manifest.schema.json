        },
        "cx": {
          "exclusiveMinimum": 0,
          "title": "Cx",
          "type": "integer"
        },
        "cy": {
          "exclusiveMinimum": 0,
          "title": "Cy",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "cx",
        "cy"
      ],
      "title": "BBox",
      "type": "object"
    },
    "BulletStyle": {
      "additionalProperties": false,
      "description": "Маркер списка первого уровня — часть дизайн-системы шаблона, а не наш вкус.\n\nСвободный текстбокс в OOXML не наследует ни знака, ни отступа: родителя-плейсхолдера\nу него нет. Без этих сведений список выглядит набором абзацев (прогон 2ac85990b2f2).\nШаблон, который маркера не задаёт, остаётся без маркера: дорисовывать «типовую точку»\nзначит придумывать чужой дизайн.",
      "properties": {
        "char": {
          "description": "Знак маркера из buChar",
          "maxLength": 4,
          "minLength": 1,
          "title": "Char",
          "type": "string"
        },
        "font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Гарнитура знака из buFont",
          "title": "Font"
        },
        "color_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Цвет — слотом темы (ADR-002)"
        },
        "margin_left_emu": {
          "default": 0,
          "description": "marL: отступ абзаца",
          "minimum": 0,
          "title": "Margin Left Emu",
          "type": "integer"
        },
        "indent_emu": {
          "default": 0,
          "description": "indent: вынос маркера, ≤ 0",
          "maximum": 0,
          "title": "Indent Emu",
          "type": "integer"
        }
      },
      "required": [
        "char"
      ],
      "title": "BulletStyle",
      "type": "object"
    },
    "ChartDefaults": {
      "additionalProperties": false,
      "properties": {
        "series_color_refs": {
          "items": {
            "$ref": "#/$defs/ColorRef"
          },
          "title": "Series Color Refs",
          "type": "array"
        }
      },
      "title": "ChartDefaults",
      "type": "object"
    },
    "ColorRef": {
      "description": "Имена цветов схемы темы. RGB-литералы в IR запрещены (ADR-002).",
      "enum": [
        "dk1",
        "lt1",
        "dk2",
        "lt2",
        "accent1",
        "accent2",
        "accent3",
        "accent4",
        "accent5",
        "accent6",
        "hlink",
        "folHlink"
      ],
      "title": "ColorRef",
      "type": "string"
    },
    "ComponentKind": {
      "description": "Вид повторяющегося элемента шаблона.\n\nСписок короткий нарочно: это те виды, которые наш рендерер умеет рисовать сам\n(`kpi`, `smartart`, плитки). Вид, который мы не рисуем, в каталоге бесполезен —\nописать его есть чем, а воспользоваться нечем.",
      "enum": [
        "tile",
        "picture_caption",
        "kpi"
      ],
      "title": "ComponentKind",
      "type": "string"
    },
    "ComponentSpec": {
      "additionalProperties": false,
      "description": "Повторяющийся элемент, который автор шаблона нарисовал сам. Задача DS3.\n\nКаталог собирается из слайдов-примеров: элемент, повторённый на одном слайде три\nраза и больше с равным шагом, — это не случайность, а компонент дизайн-системы.\nУ VK WorkSpace так устроена «картинка + подпись», у VK Education — карточка.\n\nХранятся **параметры**, а не куски XML. Скопированный фрагмент принёс бы с собой\nлитеральные цвета (19 штук у VK Tech), а правило 5 требует ссылку на слот темы.\nПо этим параметрам рисует наш рендерер (DS4), и тогда плитки и показатели\nполучаются в пропорциях шаблона, а не в наших.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "repeats": {
          "description": "Сколько экземпляров стояло рядом",
          "minimum": 3,
          "title": "Repeats",
          "type": "integer"
        },
        "axis": {
          "description": "row — экземпляры в ряд, column — столбцом",
          "title": "Axis",
          "type": "string"
        },
        "width_share": {
          "description": "Ширина экземпляра в долях слайда",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width Share",
          "type": "number"
        },
        "height_share": {
          "description": "Высота экземпляра в долях слайда",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height Share",
          "type": "number"
        },
        "gap_share": {
          "description": "Шаг между экземплярами в долях стороны вдоль оси",
          "maximum": 1,
          "minimum": 0,
          "title": "Gap Share",
          "type": "number"
        },
        "parts": {
          "description": "Из чего состоит экземпляр, по одному разу на вид",
          "items": {
            "$ref": "#/$defs/ShapeKind"
          },
          "title": "Parts",
          "type": "array"
        },
        "text_sizes_pt": {
          "description": "Кегли текстов экземпляра по убыванию",
          "items": {
            "type": "number"
          },
          "title": "Text Sizes Pt",
          "type": "array"
        },
        "fill_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Заливка экземпляра слотом темы"
        },
        "fill_hex": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fill Hex"
        },
        "seen_on": {
          "description": "Номера слайдов-примеров, где элемент встречен",
          "items": {
            "type": "integer"
          },
          "title": "Seen On",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "repeats",
        "axis",
        "width_share",
        "height_share",
        "gap_share"
      ],
      "title": "ComponentSpec",
      "type": "object"
    },
