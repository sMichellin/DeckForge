    "LayoutShape": {
      "additionalProperties": false,
      "description": "Фигура макета **вне** плейсхолдеров.\n\nШаблоны сплошь и рядом кладут фон, фотографию или декоративный знак обычной фигурой,\nа не плейсхолдером. Для наполнения такая фигура бесполезна — в неё ничего не положить, —\nно для понимания макета необходима: без неё «Паттерн + фото» выглядит как пустой слайд\nс заголовком.",
      "properties": {
        "shape_id": {
          "title": "Shape Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ShapeKind"
        },
