    "ExampleShape": {
      "additionalProperties": false,
      "description": "Одна фигура слайда-примера, приведённая к координатам слайда.\n\nПримеры — это то, что автор шаблона нарисовал сам: у трёх шаблонов кейса от 87 %\nдо 96 % их содержимого лежит **вне** плейсхолдеров, обычными фигурами поверх почти\nпустого макета. Поэтому у примера важна не «вместимость», а геометрия, тип и набор:\nпо ним видно, каким автор считает слайд этого макета.\n\nФигуры внутри групп раскрыты, а их геометрия и кегль пересчитаны с учётом масштаба\nгруппы: у VK Tech иначе кегли 6,75 и 8,12 pt выглядят ступенями шкалы, хотя это\nмасштаб группы, а не решение о типографике.",
      "properties": {
        "shape_id": {
          "title": "Shape Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ShapeKind"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "cx": {
          "exclusiveMinimum": 0,
          "title": "Cx",
          "type": "integer"
        },
        "cy": {
          "exclusiveMinimum": 0,
          "title": "Cy",
          "type": "integer"
        },
        "z": {
          "default": 0,
          "minimum": 0,
          "title": "Z",
          "type": "integer"
        },
        "xml_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Настоящий cNvPr id фигуры в XML; по нему фигура находится при копировании рецепта",
          "title": "Xml Id"
        },
        "placeholder_idx": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "idx плейсхолдера макета, если фигура стоит в нём; иначе свободная фигура",
          "title": "Placeholder Idx"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Роль текста, если её удалось определить по кеглю и месту"
        },
        "text_len": {
          "default": 0,
          "description": "Длина текста фигуры в знаках",
          "minimum": 0,
          "title": "Text Len",
          "type": "integer"
        },
        "size_pt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Кегль, приведённый к масштабу слайда",
          "title": "Size Pt"
        },
        "layout_size_pt": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout Size Pt"
        },
        "font_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Гарнитура; ссылки +mj-lt/+mn-lt разрешены через тему",
          "title": "Font Family"
        },
        "color_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Цвет текста слотом темы"
        },
        "color_hex": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Литеральный цвет текста, когда он не сводится к слоту темы",
          "title": "Color Hex"
        },
        "fill_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Заливка фигуры слотом темы"
        },
        "fill_hex": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Литеральная заливка фигуры: из неё складывается палитра шаблона",
          "title": "Fill Hex"
        }
      },
