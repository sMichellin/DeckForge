    "CalloutBlock": {
      "additionalProperties": false,
      "description": "Callout «инсайт» или «риск» (DG4, страница дизайн-системы #142).\n\n`tone` — закрытое перечисление: вид callout входит в контракт. Плашку, подпись вида\nи отступы рисует вёрстка; кегля здесь нет (правило 6).",
      "properties": {
        "x": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "cx": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cx"
        },
        "cy": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cy"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "type": {
          "const": "callout",
          "default": "callout",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tone": {
          "$ref": "#/$defs/CalloutTone"
        },
        "accent_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Слот темы для акцента; не задан — акцент берёт вёрстка по дизайн-системе"
        }
      },
      "required": [
        "block_id",
        "text",
        "tone"
      ],
      "title": "CalloutBlock",
      "type": "object"
    },
    "CalloutTone": {
      "description": "Вид callout. Набор закрыт: это часть контракта, а не вкус композитора (DG4).\n\nЦвет и подпись вида решает вёрстка по дизайн-системе, а не модель.",
      "enum": [
        "insight",
        "risk"
      ],
      "title": "CalloutTone",
      "type": "string"
    },
