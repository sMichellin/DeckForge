{
  "$defs": {
    "BulletItem": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "level": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "icon": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Иконка пункта иконочного списка: имя Lucide (shield-check), не путь и не цвет",
          "title": "Icon"
        }
      },
      "required": [
        "text"
      ],
      "title": "BulletItem",
      "type": "object"
    },
    "BulletsBlock": {
